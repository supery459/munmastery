# Required for the Debate Simulator and Speech Analysis modules to generate
# live AI responses (delegate speeches, points of inquiry, executive
# scorecards, and speech diagnostics) via the Gemini API.
#
# Get a key at https://aistudio.google.com/apikey, then copy this file to
# .env.local and fill it in:
#
#   cp .env.example .env.local
#
# Without a key, both modules automatically fall back to a local, scripted
# simulation so the app still works end to end.
GEMINI_API_KEY=
